@model SmartCampusPortal.Models.ServiceRequest

@{
    ViewData["Title"] = "Submit Request";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Submit Service Request
                </h5>
            </div>

            <div class="card-body">
                @if (ViewBag.ServiceName != null)
                {
                    <div class="alert alert-light border py-2 mb-3">
                        <small class="text-muted">Selected Service:</small>
                        <strong class="text-primary ms-1">@ViewBag.ServiceName</strong>
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small"></div>
                    <input type="hidden" asp-for="ServiceId" />

                    <div class="mb-3">
                        <label class="form-label">Student Name: <span class="text-danger">*</span></label>
                        <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select">
                            <option value="">-- Select Your Student Account --</option>
                        </select>
                        <span asp-validation-for="StudentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Request Title: <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Wi-Fi issue in Lab 2 / Fan repair" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description: <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe your problem or request in detail..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2"></i> Submit Request
                        </button>
                        <a asp-controller="CampusServices" asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
