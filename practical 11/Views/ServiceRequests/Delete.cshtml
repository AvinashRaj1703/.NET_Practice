@model SmartCampusPortal.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Request";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Delete Service Request
                </h5>
            </div>

            <div class="card-body">
                <div class="alert alert-warning py-2 small">
                    Are you sure you want to permanently delete this service request?
                </div>

                <table class="table table-bordered table-sm mb-3">
                    <tr>
                        <th class="bg-light" style="width: 35%;">Request ID</th>
                        <td>#@Model.RequestId</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Student</th>
                        <td>@Model.Student?.FullName</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Campus Service</th>
                        <td>@Model.CampusService?.ServiceName</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Title</th>
                        <td>@Model.Title</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Status</th>
                        <td><span class="badge bg-secondary">@Model.Status</span></td>
                    </tr>
                    <tr>
                        <th class="bg-light">Created Date</th>
                        <td>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                    </tr>
                </table>

                <form asp-action="Delete" asp-route-id="@Model.RequestId" method="post">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
