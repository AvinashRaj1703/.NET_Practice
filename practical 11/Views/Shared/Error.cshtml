@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5 mb-5" style="max-width: 650px;">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden text-center p-5">
        <div class="stat-icon-wrapper stat-icon-warning mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
        </div>
        
        <h2 class="fw-bold text-dark mb-2">Something Went Wrong</h2>
        <p class="text-muted mb-4">An unexpected error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <div class="alert alert-light border py-2 px-3 d-inline-block mx-auto mb-4 small">
                <span class="text-muted">Request Identifier:</span> <code class="text-danger fw-bold">@Model.RequestId</code>
            </div>
        }

        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-house-door-fill me-1"></i> Return to Homepage
            </a>
        </div>
    </div>
</div>
