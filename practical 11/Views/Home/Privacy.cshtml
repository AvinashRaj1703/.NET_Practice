@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card shadow-sm">
    <div class="card-header bg-light fw-bold">
        <i class="bi bi-shield-lock me-1"></i> Privacy & Usage Policy
    </div>
    <div class="card-body">
        <h5 class="fw-bold">Smart Campus Service Portal - Student Project</h5>
        <p class="text-muted">
            This web application is developed for academic demonstration purposes (Practical 11).
        </p>

        <h6 class="fw-bold mt-3">Data Privacy</h6>
        <p class="text-muted small">
            Student details (such as names, enrollment numbers, and email IDs) entered into this system are stored locally in the application database and are used solely to demonstrate service request routing and status tracking.
        </p>

        <h6 class="fw-bold mt-3">Academic Context</h6>
        <p class="text-muted small mb-0">
            Technology stack: ASP.NET Core MVC 8.0, Entity Framework Core with SQLite database.
        </p>
    </div>
</div>
