@model IEnumerable<ProductCatalog.Models.Product>
@{
    ViewBag.Title = "Product List";
}

<table border="1" cellpadding="8">
    <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Action</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category</td>
            <td>@item.Price</td>
            <td>@item.Quantity</td>
            <td>@Html.ActionLink("Details", "Details", new { id = item.Id })</td>
        </tr>
    }
</table>
