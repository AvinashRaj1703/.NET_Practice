@model List<WebApplication7.Models.Feedback>

@{
    ViewBag.Title = "Submitted Feedback";
}

<h2>Submitted Feedback</h2>

@if (Model.Count == 0)
{
    <p>No feedback has been submitted yet.</p>
}
else
{
    <table border="1" cellpadding="10">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Feedback</th>
        </tr>

        @foreach (var feedback in Model)
        {
            <tr>
                <td>@feedback.Id</td>
                <td>@feedback.Name</td>
                <td>@feedback.Email</td>
                <td>@feedback.Message</td>
            </tr>
        }
    </table>
}

<br />

<a href="@Url.Action("Index", "Feedback")">
    Give New Feedback
</a>