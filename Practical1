using System;

namespace StudentAdmissionSystem
{
    class Student
    {
        private int id;
        private string name;
        private string course;
        private double fees;

        public Student(int id, string name, string course, double fees)
        {
            this.id = id;
            this.name = name;
            this.course = course;
            this.fees = fees;
        }

        public void DisplayDetails()
        {
            Console.WriteLine("--- Student Admission Details ---");
            Console.WriteLine("Student ID: " + id);
            Console.WriteLine("Student Name: " + name);
            Console.WriteLine("Course: " + course);
            Console.WriteLine("Fees: " + fees);
            Console.WriteLine();
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Student s1 = new Student(3491, "Avinash Raj", "Computer Engineering", 600000);
            Student s2 = new Student(3339, "Sushmita Nandani", "Computer Engineering", 600000);

            s1.DisplayDetails();
            s2.DisplayDetails();

            Console.ReadKey();
        }
    }
}
